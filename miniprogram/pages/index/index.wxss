.page { padding: 32rpx; }.header { padding: 28rpx 8rpx 34rpx; }.eyebrow { color: #1c7c56; font-size: 20rpx; letter-spacing: 3rpx; font-weight: 700; }.title { margin-top: 12rpx; font-size: 54rpx; font-weight: 800; letter-spacing: -3rpx; }.subtitle { margin-top: 8rpx; color: #758078; font-size: 26rpx; }.card { margin-bottom: 24rpx; padding: 30rpx; background: #fff; border: 1rpx solid #e5ebe5; border-radius: 24rpx; box-shadow: 0 10rpx 40rpx rgba(35,71,53,.04); }.section-title { font-size: 34rpx; font-weight: 800; }.fields { display: flex; gap: 16rpx; margin: 24rpx 0; }.fields input { flex: 1; padding: 22rpx; background: #f8faf7; border: 1rpx solid #dfe7e1; border-radius: 14rpx; font-size: 25rpx; }.primary { color: #fff; background: #1c7c56; font-size: 28rpx; }.status { margin-top: 18rpx; color: #a06b31; font-size: 22rpx; }.status-on { color: #1c7c56; }.metrics { display: grid; grid-template-columns: 1.25fr 1fr 1fr; gap: 14rpx; margin-bottom: 24rpx; }.metric { padding: 24rpx; background: #fff; border: 1rpx solid #e5ebe5; border-radius: 20rpx; }.metric text { color: #758078; font-size: 21rpx; }.metric view { margin: 12rpx 0 2rpx; color: #0f4c36; font-size: 48rpx; font-weight: 800; }.metric-main { background: #d7f46b; border-color: #c8e75d; }.metric-main view { color: #173e2e; font-size: 58rpx; }.note { margin: 20rpx 0; color: #758078; font-size: 23rpx; line-height: 1.6; }.shot-row { display: flex; gap: 12rpx; }.shot-row button { flex: 1; padding: 16rpx 4rpx; color: #0f4c36; background: #eef7e8; font-size: 23rpx; }.shot-row button text { display: block; margin-top: 6rpx; font-size: 32rpx; font-weight: 800; }.shot-row .hot { color: #8c452f; background: #fff1e9; }.reset { margin-top: 22rpx; color: #1c7c56; background: #e8f1e7; font-size: 25rpx; }
.equip-fields { display: flex; gap: 14rpx; margin: 18rpx 0; }.equip-fields picker, .equip-fields input { flex: 1; }.picker, .equip-fields input { padding: 20rpx; color: #536058; background: #f8faf7; border: 1rpx solid #dfe7e1; border-radius: 14rpx; font-size: 24rpx; }.equip-result { margin-top: 16rpx; padding: 20rpx; background: #f5f8f2; border-radius: 14rpx; }.equip-name { color: #0f4c36; font-size: 28rpx; font-weight: 800; }.equip-price { margin-top: 8rpx; color: #536058; font-size: 22rpx; }.equip-reason, .equip-source { margin-top: 8rpx; color: #758078; font-size: 22rpx; line-height: 1.5; }.equip-source { padding-top: 8rpx; border-top: 1rpx solid #dfe7e1; font-size: 20rpx; }
